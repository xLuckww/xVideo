<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Tauri 以 hardened runtime 重新签名主程序和 externalBin（ffmpeg / ffprobe / deno），会丢掉它们原有的权限。
  deno 的 V8 需要 JIT 才能分配可执行内存，否则启动即崩溃（Failed to reserve virtual memory for CodeRange），
  YouTube 的 JS 校验随之失败。
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
